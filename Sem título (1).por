programa {
  funcao inicio() {
    
		real m1, m2, m3, m4, media

		escreva ("Informe a média 1: " )
		leia (m1)
		escreva( "Informe a média 2: ")
		leia (m2)
		escreva ("Informe a média 3: ")
		leia (m3)
    escreva("Informe a média 4: ")
    leia(m4)

		media = (m1 + m2 + m3 + m4) / 4 

		limpa()
		escreva ("A média final é: ", media, "\n\n")

  }
}
