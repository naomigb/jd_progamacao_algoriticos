programa {
  funcao inicio() {
    inteiro n1, n2, n3, produto

    escreva("digite o primeiro numero: ")
    leia(n1)
    escreva("digite o segundo numero: ")
    leia(n2)
    escreva("digite o terceiro numero: ")
    leia(n3)

produto = n1 + n2 + n3 

escreva("o resultado da soma entre os numeros são: ", produto)
  }
}
